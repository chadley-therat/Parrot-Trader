[Unit]
Description=Parrot Binder — offline Pokémon TCG PWA server
After=network.target
Wants=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/parrot-binder
ExecStart=/home/pi/parrot-binder/.venv/bin/python server.py --host 0.0.0.0 --port 5000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Give Flask a moment to start before marking active
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
